
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: #f4f7f9;
    color: #183C63;
    line-height: 1.6;

    transition: 0.3s;
}


/* =========================
   HEADER
========================= */

header {
    background-color: #183C63;
    color: white;
    padding: 25px 20px;

    text-align: center;

    position: sticky;
    top: 0;
    z-index: 1000;
}

header h1 {
    font-size: 32px;
}

header p {
    font-size: 18px;
    margin-bottom: 15px;
}

nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;

    flex-wrap: wrap;

    margin: 15px 0;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;

    transition: 0.3s;
}

nav a:hover {
    color: #7ed957;
}


/* =========================
   BOTÃO
========================= */

button {
    border: none;

    padding: 10px 18px;

    border-radius: 20px;

    cursor: pointer;

    background-color: white;
    color: #183C63;

    font-weight: bold;

    transition: 0.3s;
}

button:hover {
    background-color: #7ed957;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 450px;

    display: flex;

    align-items: center;
    justify-content: center;

    text-align: center;

    padding: 50px 20px;

    background:
        linear-gradient(
            rgba(24, 60, 99, 0.8),
            rgba(24, 60, 99, 0.8)
        );

    color: white;
}

.hero-text {
    max-width: 800px;
}

.hero h2 {
    font-size: 42px;

    margin-bottom: 20px;
}

.hero p {
    font-size: 20px;

    margin-bottom: 30px;
}

.botao {
    display: inline-block;

    padding: 12px 25px;

    background-color: #7ed957;

    color: #183C63;

    text-decoration: none;

    border-radius: 8px;

    font-weight: bold;

    transition: 0.3s;
}

.botao:hover {
    transform: scale(1.05);
}


/* =========================
   SEÇÕES
========================= */

section {
    max-width: 1200px;

    margin: auto;

    padding: 70px 20px;
}

section h2 {
    text-align: center;

    font-size: 32px;

    margin-bottom: 40px;

    color: #183C63;
}


/* =========================
   CARDS
========================= */

.articles {
    display: flex;

    flex-wrap: wrap;

    justify-content: center;

    gap: 10px;
}


/* Seu estilo de article,
   melhorado */

article {
    display: flex;
    flex-direction: column;

    align-items: center;

    text-align: center;

    justify-content: center;

    border: 1px solid #183C63;

    margin: 16px;

    gap: 16px;

    padding: 25px;

    flex: 1 1 25%;

    min-width: 250px;

    background-color: white;

    border-radius: 12px;

    box-shadow:
        0 4px 10px rgba(0, 0, 0, 0.08);

    transition:
        transform 0.3s,
        box-shadow 0.3s;
}


/* Efeito ao passar o mouse */

article:hover {
    transform: translateY(-8px);

    box-shadow:
        0 10px 25px rgba(0, 0, 0, 0.15);
}


article h3 {
    font-size: 22px;

    color: #183C63;
}


article p {
    color: #555;

    font-size: 16px;
}


/* =========================
   ÍCONES
========================= */

.icone {
    font-size: 55px;
}


/* =========================
   GALERIA
========================= */

.galeria {
    display: flex;

    flex-wrap: wrap;

    justify-content: center;

    gap: 20px;
}

.foto {
    width: 250px;
    height: 200px;

    display: flex;

    flex-direction: column;

    justify-content: center;
    align-items: center;

    text-align: center;

    border-radius: 12px;

    background-color: #dcecf5;

    font-size: 60px;

    transition: 0.3s;
}

.foto:hover {
    transform: scale(1.05);
}

.foto p {
    font-size: 16px;

    color: #183C63;

    font-weight: bold;
}


/* =========================
   FOOTER
========================= */

footer {
    background-color: #183C63;

    color: white;

    text-align: center;

    padding: 40px 20px;
}

footer h2 {
    margin-bottom: 10px;
}


/* =========================
   DARK MODE
========================= */

body.dark {
    background-color: #101820;

    color: #eeeeee;
}

body.dark section h2 {
    color: #7ed957;
}

body.dark article {
    background-color: #1b2833;

    border-color: #7ed957;
}

body.dark article h3 {
    color: #7ed957;
}

body.dark article p {
    color: #dddddd;
}

body.dark .foto {
    background-color: #263746;
}

body.dark .foto p {
    color: #7ed957;
}


/* =========================
   RESPONSIVIDADE
========================= */

@media (max-width: 768px) {

    header h1 {
        font-size: 25px;
    }

    nav {
        gap: 12px;
    }

    .hero h2 {
        font-size: 32px;
    }

    .hero p {
        font-size: 17px;
    }

    article {
        flex: 1 1 100%;

        margin: 10px 0;
    }

    .foto {
        width: 100%;
        max-width: 350px;
    }
}
